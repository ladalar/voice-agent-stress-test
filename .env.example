# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# HuggingFace API token (for Mistral 7B patient response generation)
# Get yours at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook base URL (your publicly accessible server URL, e.g. ngrok)
# Example: https://abc123.ngrok.io
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# Target phone number to call (the test line)
TARGET_PHONE_NUMBER=+18054398008

# Optional: Flask server port (default 5000)
PORT=5000
